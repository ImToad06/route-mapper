{
  "name": "lh-rutas",
  "private": true,
  "version": "0.0.0",
  "description": "Sistema de gestión y asignación de rutas — L&H Distribuciones",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @lh/api dev",
    "dev:web": "bun run --filter @lh/web dev",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @lh/api db:generate",
    "db:migrate": "bun run --filter @lh/api db:migrate",
    "db:seed": "bun run --filter @lh/api db:seed",
    "prepare": "lefthook install",
    "test:e2e": "playwright test"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "bun-types": "^1.4.2",
    "lefthook": "^2.1.12",
    "typescript": "^7.0.2"
  }
}

# Copiar a .env y ajustar. Nunca subir .env al repositorio.
# Zona horaria de la empresa (Barranquilla): de esto depende "hoy" en el panel y los filtros por fecha.
TZ=America/Bogota
POSTGRES_USER=lh
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=lh_rutas
DATABASE_URL=postgres://lh:cambiar-esta-clave@localhost:5432/lh_rutas

API_PORT=3000
JWT_SECRET=cambiar-por-una-cadena-aleatoria-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Intentos fallidos de ingreso por IP cada 15 minutos
LOGIN_MAX_INTENTOS=10
# Cookie de refresco: auto = Secure solo si la petición llegó por HTTPS
COOKIE_SEGURA=auto
# true si la API está detrás de Nginx (docker compose lo fija solo)
CONFIAR_PROXY=false

# Motores de rutas (Fase 3). En Docker Compose la API usa http://osrm:5000 y http://vroom:3000.
# En desarrollo local (bun run dev) con `docker compose --profile mapas up -d osrm vroom`:
OSRM_URL=http://localhost:5000
VROOM_URL=http://localhost:3300
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=lh-rutas/0.1 (contacto@lh-distribuciones.example)

# Web
VITE_API_URL=http://localhost:3000

# Respaldos (RNF-11). Hora local (TZ) de la copia nocturna y días de retención en el servidor.
BACKUP_HORA=02:00
BACKUP_KEEP_DAYS=14
# Copia fuera del servidor con rclone (cualquier almacenamiento S3: Backblaze B2, Cloudflare R2, Wasabi, AWS…).
# Déjelo vacío para usar solo la copia local. Formato: offsite:<bucket>/<carpeta>
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=60
RCLONE_OFFSITE_PROVIDER=Other
RCLONE_OFFSITE_ENDPOINT=
RCLONE_OFFSITE_REGION=
RCLONE_OFFSITE_ACCESS_KEY_ID=
RCLONE_OFFSITE_SECRET_ACCESS_KEY=
